# OpenRouter API key (https://openrouter.ai/keys). Required for the
# Crosswalker and the Audit Scope Analyzer; the Gap Analyzer does not use it.
OPENROUTER_API_KEY="your_api_key_here"

# Optional: OpenRouter model ID. Defaults to meta-llama/llama-3.1-8b-instruct.
# OPENROUTER_MODEL="meta-llama/llama-3.1-8b-instruct"

# Optional: run all three tools on a synthetic demo catalog with a canned
# stand-in for the model. No API key, no SCF or Hugging Face download.
# Refused when ENVIRONMENT=production or staging.
# DEMO_MODE=1
